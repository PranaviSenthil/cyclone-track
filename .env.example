# CYCLOTRACK Environment Configuration
# API Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Data Provider Configuration
# MOSDAC / INSAT API credentials (Optional: if not configured, provider reports CREDENTIALS_REQUIRED)
MOSDAC_API_KEY=
MOSDAC_USER_EMAIL=
MOSDAC_API_BASE_URL=https://mosdac.gov.in/live/

# NASA GIBS WMTS Endpoint
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi

# NOAA IBTrACS data configuration
IBTRACS_DATA_PATH=ml/data/historical/ibtracs_north_indian_ocean.csv
CACHE_DIR=cache
MODEL_ARTIFACTS_DIR=artifacts/checkpoints

# Operational Flags
ENABLE_DEMO_FALLBACK=True
DEMO_STORM_DEFAULT=BIPARJOY_2023
